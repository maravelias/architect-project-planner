<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
	  xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
	  title="msg://clientListView.title"
	  focusComponent="clientsDataGrid">
	<data>
		<collection id="clientsDc"
					class="eu.maravelias.architectprojectplanner.entity.Client">
			<fetchPlan extends="_base"/>
			<loader id="clientsDl" readOnly="true">
				<query>
					<![CDATA[select e from client e]]>
				</query>
			</loader>
		</collection>
	</data>
	<facets>
		<dataLoadCoordinator auto="true"/>
		<urlQueryParameters>
			<genericFilter component="genericFilter"/>
			<pagination component="pagination"/>
		</urlQueryParameters>
	</facets>
	<actions>
		<action id="selectAction" type="lookup_select"/>
		<action id="discardAction" type="lookup_discard"/>
	</actions>
	<layout>
		<genericFilter id="genericFilter"
					   dataLoader="clientsDl">
			<properties include=".*"/>
		</genericFilter>
		<hbox id="buttonsPanel" classNames="buttons-panel">
			<startSlot>
				<button id="createButton" action="clientsDataGrid.createAction"/>
				<button id="editButton" action="clientsDataGrid.editAction"/>
				<button id="refreshButton" action="clientsDataGrid.refreshAction"/>
				<button id="removeButton" action="clientsDataGrid.removeAction"/>
			</startSlot>
			<endSlot>
				<simplePagination id="pagination" dataLoader="clientsDl"/>
			</endSlot>
		</hbox>
		<dataGrid id="clientsDataGrid"
				  width="100%"
				  minHeight="20em"
				  dataContainer="clientsDc"
				  columnReorderingAllowed="true">
			<actions>
				<action id="createAction" type="list_create"/>
				<action id="editAction" type="list_edit"/>
				<action id="refreshAction" type="list_refresh"/>
				<action id="removeAction" type="list_remove"/>
			</actions>
			<columns resizable="true">
				<column property="name"/>
				<column property="description"/>
			</columns>
		</dataGrid>
		<hbox id="lookupActions" visible="false">
			<button id="selectButton" action="selectAction"/>
			<button id="discardButton" action="discardAction"/>
		</hbox>
	</layout>
</view>
